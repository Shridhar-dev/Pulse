# Application Settings
PROJECT_NAME=Pulse
API_V1_STR=/api/v1

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://pulse_admin:pulse_password@localhost:5432/pulse_audit

# Redis Configuration (BullMQ and Locks)
REDIS_URL=redis://localhost:6379/1

# Queue Configuration
QUEUE_NAME=pulse_events_queue
DLQ_NAME=pulse_dead_letters
MAX_RETRIES=3

# Scheduler settings
SCHEDULER_BATCH_SIZE=1000
SCHEDULER_INTERVAL_MS=100

# Fault Tolerance
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
DISTRIBUTED_LOCK_TIMEOUT_SECONDS=30
DEFAULT_WEBHOOK_URL="http://localhost:8000/api/v1/health"

# Load Testing Limits
LOAD_TEST_CONCURRENCY=60
LOAD_TEST_TOTAL_TASKS=10000

# Router
ROUTER_TAG_JOBS="Jobs"
ROUTER_TAG_METRICS="Metrics"
