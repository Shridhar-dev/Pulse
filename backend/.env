# Application Settings
PROJECT_NAME=Pulse
API_V1_STR=/api/v1

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://pulse_admin:pulse_password@localhost:5432/pulse_audit

# Redis Configuration (BullMQ and Locks)
REDIS_URL=redis://localhost:6379/1

# Queue Configuration
QUEUE_NAME=pulse_events_queue
DLQ_NAME=pulse_dead_letters
MAX_RETRIES=3

# Scheduler settings
SCHEDULER_BATCH_SIZE=100
SCHEDULER_INTERVAL_MS=500
